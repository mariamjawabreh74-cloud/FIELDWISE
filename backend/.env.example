# FIELDWISE Backend Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Google Gemini API Key (keep server-side only!)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional NASA Earthdata token (if accessing protected Earthdata collections)
EARTHDATA_TOKEN=

# Cache directory for NASA and satellite data
CACHE_DIR=./data_cache
